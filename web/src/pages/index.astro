---
import Page from "../layouts/Page.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TerminalWindow from "../components/TerminalWindow.astro";
import CheckRows from "../components/CheckRows.astro";
import sample from "../data/sample-result.json";
const doneCount = sample.steps.filter((s) => s.mark === "done").length;
const total = sample.steps.length;
const visible = [
  ...sample.steps.filter((s) => s.mark === "done"),
  ...sample.steps.filter((s) => s.mark === "next").slice(0, 1),
  ...sample.steps.filter((s) => s.mark === "to do").slice(0, 1)
];
const hiddenCount = total - visible.length;
const commitShort = (sample.commit as string).slice(0, 7).toUpperCase();
const ownerRepo = `${sample.owner}/${sample.repo}`;
---
<Page>
<Header />
<div id="landing">
<section id="top" class="hero">
  <ul class="badges">
    <li class="badge-green">yokoten {sample.yokotenVersion}</li>
  </ul>
  <h1>A health check for repos that AI agents work in.</h1>
  <p>13 file checks, the one next step, and the files that fix it. Your code never runs.</p>
  <form id="check-form" novalidate class="check-form">
    <label for="repo-input">GitHub repo URL</label>
    <div class="input-row">
      <input id="repo-input" name="url" type="url" placeholder="https://github.com/owner/repo" autocomplete="off" />
      <button type="submit">Check</button>
    </div>
  </form>
  <p id="check-error" class="error-box" role="alert" hidden></p>
  <noscript><p>This page needs JavaScript to run a check. You can also run it yourself: npx yokoten</p></noscript>
  <div id="hero-live" class="hero-live" hidden></div>
</section>
<section id="checks" class="checks">
  <h2>Real checks <span class="checks-date">Latest check {sample.examplesCheckedOn}</span></h2>
  <div class="checks-groups">
    <div class="checks-group">
      <h3 class="checks-group-title">Web2</h3>
      <CheckRows examples={sample.examples.filter((ex) => ex.group === "web2")} />
    </div>
    <div class="checks-group">
      <h3 class="checks-group-title">Web3</h3>
      <CheckRows examples={sample.examples.filter((ex) => ex.group === "web3")} />
    </div>
  </div>
  <p class="checks-note">Green is done now. Outlined is what the files add.</p>
  <p class="checks-note">Four of the 13 checks need yokoten, our own tool, so a repo without it can reach 9 of 13.</p>
</section>
<section id="result" class="band">
  <div class="band-inner">
    <p class="section-label"><span>01 ·</span> A real result</p>
    <h2 class="section-title">What you get</h2>
    <div class="result-columns">
      <div class="result-left">
        <ul class="get-list">
          <li>Where the repo stands, and the one next step.</li>
          <li>Files for this repo, ready to commit. Muse writes the project section.</li>
          <li>The commands that repeat this check.</li>
        </ul>
      </div>
      <div class="result-right">
        <TerminalWindow title="REAL RESULT" aside={commitShort}>
          <div class="sample-title">{ownerRepo} · {doneCount} of {total} file checks</div>
          <div class="spacer"></div>
          {visible.map((s) => {
            if (s.mark === "done") return (<div class="terminal-row is-done"><span>✓ done</span><span>{s.title}</span></div>);
            if (s.mark === "next") return (<div class="terminal-row is-next"><span>● next</span><span>{s.title}</span></div>);
            return (<div class="terminal-row is-todo"><span>● to do</span><span>{s.title}</span></div>);
          })}
          <div class="terminal-row is-more"><span>+{hiddenCount}</span><span>more to do</span></div>
          <div class="spacer"></div>
          <div class="muse-label">Muse wrote for this repo:</div>
          {sample.museLines.map((line: string) => <div>{line}</div>)}
        </TerminalWindow>
      </div>
    </div>
  </div>
</section>
<section id="how" class="section-inner">
  <p class="section-label"><span>02 ·</span> What it doesn't do</p>
  <h2 class="section-title">It reads. It does not touch.</h2>
  <ul class="facts">
    <li><strong>Your code never runs.</strong> No install, no build, no tests.</li>
    <li><strong>The network is cut.</strong> yokoten runs in a throwaway sandbox, with no way out.</li>
    <li><strong>Your repo stays yours.</strong> Nothing changes until you click Commit on GitHub.</li>
  </ul>
  <p class="facts-note">It reads public repos only. Muse's text stays in a cache for 24 hours. It does not scan for code vulnerabilities. It is free, with no account, and each visitor gets 10 checks an hour.</p>
</section>
<section id="proof" class="band">
  <div class="band-inner">
    <p class="section-label"><span>03 ·</span> Don't trust us</p>
    <h2 class="section-title">Run it yourself.</h2>
    <p class="proof-lede">Every result gives you the version, the commit and the command.</p>
    <p class="proof-note">Its hash is on Sigstore Rekor and a Solana devnet memo, so a later change would show. Devnet is a test network.</p>
  </div>
</section>
<section class="cta">
  <div class="cta-inner">
    <p class="cta-title">This page looks once. yokoten stays on guard.</p>
    <a href="https://yokoten.app/" class="cta-link">See what it stops</a>
  </div>
</section>
</div>
<main id="app" hidden></main>
<Footer />
<script src="../client/app.ts"></script>
</Page>
