---
import Mark from "./Mark.astro";
---
<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-brand">
      <div class="brand-lockup">
        <Mark id="footer-mark" size={24} />
        <span class="brand-name">yokoten doctor</span>
      </div>
      <p class="brand-note">A free check for public GitHub repos.</p>
    </div>
    <nav class="footer-links" aria-label="Links">
      <ul>
        <li><a href="/about.html">About</a></li>
        <li><a href="https://github.com/coo1white/yokoten-doctor">GitHub</a></li>
        <li><a href="https://github.com/coo1white/yokoten-doctor/issues">Report a problem</a></li>
      </ul>
    </nav>
  </div>
</footer>
