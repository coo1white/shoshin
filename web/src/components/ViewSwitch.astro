---
interface Props {
  current: "human" | "agent";
}
const { current } = Astro.props as Props;
---
<nav class="view-switch" aria-label="View">
  <a href="/" aria-current={current === "human" ? "true" : undefined}>human</a>
  <a href="/agent-view.html" aria-current={current === "agent" ? "true" : undefined}>agent</a>
</nav>
